# Só para os emuladores (projeto demo-ponto). Em produção o código fica em
# functions/.env.<id-do-projeto>, fora do git, gerado pelo "npm run publicar".
CODIGO_INSTALACAO=TESTE-LOCAL

# Limite menor que o de produção (10 por hora), para o teste de ponta a ponta
# conferir o bloqueio sem fazer dezenas de chamadas.
LIMITE_VERIFICAR_INTEGRIDADE=4
