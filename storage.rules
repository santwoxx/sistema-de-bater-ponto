rules_version = '2';

// Fotos das marcações: gravadas e lidas somente pelas Cloud Functions.
// O painel recebe a foto pela função obterFoto, que confere o acesso à
// empresa e a integridade do arquivo. Nenhum navegador lê ou grava aqui.

service firebase.storage {
  match /b/{bucket}/o {
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
