# Usado por "npm run dev:emuladores": conecta o app aos emuladores locais do
# Firebase (nada vai para a nuvem). Não contém segredos.
VITE_FIREBASE_API_KEY=demo-chave
VITE_FIREBASE_AUTH_DOMAIN=demo-ponto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-ponto
VITE_FIREBASE_STORAGE_BUCKET=demo-ponto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=demo-app
VITE_USAR_EMULADORES=true
VITE_HOST_EMULADOR=127.0.0.1
VITE_NOME_SISTEMA=Ponto Digital (testes)
